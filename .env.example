# Free/demo mode needs NO keys. Nothing here is required.

# Pass-through mode: where requests are forwarded when the caller sends an
# Authorization header. The caller's key is used for that one request and is never stored or logged.
OPENAI_BASE_URL=https://api.openai.com/v1

# Price table override: JSON of USD per 1M tokens, per model. "default" is the fallback.
# TOKENGUARD_PRICES={"my-model":{"input":0.5,"output":1.5},"default":{"input":1,"output":3}}

# Optional: persist budgets to a JSON file (used by the stdio MCP server so state survives restarts).
# TOKENGUARD_STATE_FILE=./.tokenguard-state.json

# Paid checkout links (optional; checkout is wired on kingdomofkumar.com).
# Dodo product ids: tokenguard_29 = pdt_0NqsRJYNh5L3tuuyENDEq
#                   tokenguard_79 = pdt_0NqsRJebjhEGwpM93aKOL
NEXT_PUBLIC_DODO_CHECKOUT_URL_29=
NEXT_PUBLIC_DODO_CHECKOUT_URL_79=
